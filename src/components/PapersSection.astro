---
import type { Paper, StudyUse } from '../lib/catalog';
import { humanize, trainTestLabel } from '../lib/display';
import { paperPath, withBase } from '../lib/site';

export interface PaperUse {
	use: StudyUse;
	paper: Paper | undefined;
}

interface Props {
	/** The dataset's own publications: original, benchmark or descriptor. */
	ownUses: PaperUse[];
	/** Separate studies that used the release. */
	downstreamUses: PaperUse[];
}

const { ownUses, downstreamUses: unsorted } = Astro.props;
// Oldest first, so the table reads as the history of how the release has been used.
const downstreamUses = [...unsorted].sort((a, b) => (a.paper?.data.year ?? 9999) - (b.paper?.data.year ?? 9999));
/** The first proposed model's pipeline as one line, e.g. "Whole-slide image → Tissue patches → …". */
const pipelineLine = (paper: Paper | undefined) =>
	paper?.data.models.find((model) => model.role === 'proposed' && model.pipeline.length > 0)?.pipeline.map((step) => step.label).join(' → ');
const proposedModels = (paper: Paper | undefined) =>
	(paper?.data.models ?? []).filter((model) => model.role === 'proposed').map((model) => model.name);

// Evidence status travels with the claim rather than sitting in the record,
// so a reader never has to take a paper link on trust.
const evidenceLabel = (use: StudyUse) =>
	use.actualUseEvidence.status === 'verified' ? 'Verified' : 'Not verified';
---

<section id="papers" class="stack">
	<h2>Papers and models</h2>

	<h3>The dataset's own publications</h3>
	{
		ownUses.length === 0 ? (
			<p>No publication of this release is recorded.</p>
		) : (
			<ul class="stack">
				{ownUses.map(({ use, paper }) =>
					paper ? (
						<li>
							<a href={withBase(paperPath(paper.data.slug))}>{paper.data.title}</a>
							{paper.data.year && <> ({paper.data.year})</>} <span class="badge">{humanize(use.role)}</span>
							<br />
							<small>
								<strong>{use.actualUseEvidence.status === 'verified' ? 'Link verified' : 'Link not verified'}</strong>
								{use.actualUseEvidence.note && <>. {use.actualUseEvidence.note}</>}
							</small>
						</li>
					) : null,
				)}
			</ul>
		)
	}

	<h3>Independent studies using this release</h3>
	{
		downstreamUses.length === 0 ? (
			<div class="empty-state">
				<p>No verified downstream uses are recorded yet.</p>
				<p>A paper that mentions a dataset is not listed here until its actual use is checked.</p>
			</div>
		) : (
			<div class="table-scroll">
				<table>
					<thead>
						<tr>
							<th scope="col">Paper</th>
							<th scope="col">Method</th>
							<th scope="col">Task</th>
							<th scope="col">Subset</th>
							<th scope="col">Train/test role</th>
							<th scope="col">Use evidence</th>
						</tr>
					</thead>
					<tbody>
						{downstreamUses.map(({ use, paper }) => (
							<tr>
								<th scope="row">
									{paper ? <a href={withBase(paperPath(paper.data.slug))}>{paper.data.title}</a> : use.paper}
									<small class="model-table__note">{paper?.data.year ?? 'Year not documented'}</small>
								</th>
								<td>
									{proposedModels(paper).length > 0 && <strong>{proposedModels(paper).join(', ')}</strong>}
									{paper?.data.methodSummary ? (
										<small class="model-table__note">{paper.data.methodSummary}</small>
									) : (
										<span class="muted">Not documented</span>
									)}
									{pipelineLine(paper) && <span class="pipeline-inline">{pipelineLine(paper)}</span>}
									{paper?.data.figures[0] && (
										<a class="figure-thumb" href={`${withBase(paperPath(paper.data.slug))}#architectures`} title="See the architecture">
											<img
												src={withBase(paper.data.figures[0].path)}
												alt={`${paper.data.figures[0].label} of the paper: ${paper.data.figures[0].title}`}
												width={paper.data.figures[0].width}
												height={paper.data.figures[0].height}
												loading="lazy"
												decoding="async"
											/>
										</a>
									)}
								</td>
								<td>{use.task ? humanize(use.task) : 'Not documented'}</td>
								<td>{use.subset ?? 'Not documented'}</td>
								<td>{trainTestLabel(use.trainTestRole)}</td>
								<td>{evidenceLabel(use)}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		)
	}
</section>
