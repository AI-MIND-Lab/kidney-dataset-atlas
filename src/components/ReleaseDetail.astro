---
import type { Dataset, Release } from '../lib/catalog';
import {
	overlapsForRelease,
	paperById,
	publishedReleases,
	qualityForRelease,
	samplesForRelease,
	sourcesFor,
	studyUsesForRelease,
	variablesForRelease,
} from '../lib/catalog';
import Dictionary from './Dictionary.astro';
import Samples from './Samples.astro';
import { accessLabel, countLabel, dateLabel, humanize, stateLabel, trainTestLabel } from '../lib/display';
import { datasetPath, paperPath, releasePath, withBase } from '../lib/site';

interface Props {
	dataset: Dataset;
	release: Release;
	releases: Release[];
	/** The dataset's current release, when this page is a release permalink. */
	current?: Release;
	/** True on /datasets/[slug]/, which is the canonical page for the current release. */
	isCanonical: boolean;
}

const { dataset, release, releases, current, isCanonical } = Astro.props;
const data = release.data;

const isCurrent = !current || current.data.id === data.id;
const variables = variablesForRelease(data.id);
const samples = samplesForRelease(data.id);
const findings = qualityForRelease(data.id);
const uses = studyUsesForRelease(data.id);
const usesWithPapers = await Promise.all(
	uses.map(async (use) => ({ use, paper: await paperById(use.paper) })),
);
const originalUses = usesWithPapers.filter(({ use }) => use.role === 'original');
const downstreamUses = usesWithPapers.filter(({ use }) => use.role === 'downstream');
const overlaps = overlapsForRelease(data.id);
const sources = sourcesFor(dataset.data, data);

// Overlap records name both sides, so label the other release rather than this one.
const allReleases = await publishedReleases();
const releaseLabel = (id: string) => allReleases.find((entry) => entry.data.id === id)?.data.versionLabel ?? id;

const SECTIONS = [
	['overview', 'Overview'],
	['dictionary', 'Data dictionary'],
	['samples', 'Samples'],
	['structure', 'Structure and pairing'],
	['papers', 'Papers and models'],
	['quality', 'Quality'],
	['access', 'Access and sources'],
] as const;

const countRows = [
	['Patients', data.counts.patients],
	['Examinations', data.counts.examinations],
	['Lesions', data.counts.lesions],
	['Slices', data.counts.slices],
	['Slides', data.counts.slides],
	['Records', data.counts.records],
] as const;
---

<article class="release">
	<header class="release__header stack">
		<h1>{dataset.data.name}</h1>
		<p class="lede">{dataset.data.summary}</p>
		<p>
			<span class="badge badge--accent">{data.versionLabel}</span>
			{data.modalities.map((modality) => <span class="badge">{humanize(modality)}</span>)}
			<span class="badge">{accessLabel(data.access.mode)}</span>
		</p>
		<p>
			Last verified: {dateLabel(data.verifiedOn)}.
			{data.approvedBy && <> Approved by {data.approvedBy} on {dateLabel(data.approvedOn)}.</>}
		</p>
		<p class="release__actions">
			<a class="button" href={dataset.data.officialUrl}>Official source</a>
			<a class="button" href={`${withBase('/compare/')}?releases=${data.id}`}>Compare this release</a>
			{
				data.citation && (
					<button type="button" class="button" data-copy-citation={data.citation}>
						Copy citation
					</button>
				)
			}
			<a href={withBase(releasePath(dataset.data.slug, data.id))}>Permanent link to this release</a>
			<span class="copy-status" data-copy-status role="status" aria-live="polite" />
		</p>

		<p><strong>Access:</strong> {data.access.instructions} <a href="#access">Full access details</a></p>

		{
			releases.length > 1 && (
				<nav class="release__switcher" aria-label="Releases">
					<span>Releases:</span>
					<ul>
						{releases.map((entry) => (
							<li>
								{entry.data.id === data.id ? (
									<span aria-current="true">
										{entry.data.versionLabel} <span class="badge">viewing</span>
									</span>
								) : (
									<a href={withBase(releasePath(dataset.data.slug, entry.data.id))}>
										{entry.data.versionLabel}
									</a>
								)}
								<small>{dateLabel(entry.data.releaseDate)}</small>
							</li>
						))}
					</ul>
				</nav>
			)
		}

		{
			data.catalogStatus !== 'published' && (
				<div class="notice" data-atlas-draft>
					<p>
						<strong>Draft, not approved.</strong> This record was researched but no curator has checked its
						eligibility and sources yet, so it is not published. Run <code>npm run validate</code> for its
						approval checklist.
					</p>
				</div>
			)
		}

		{
			!isCanonical && isCurrent && (
				<div class="notice">
					<p>
						This is the current release. The main dataset page is{' '}
						<a href={withBase(datasetPath(dataset.data.slug))}>{dataset.data.name}</a>.
					</p>
				</div>
			)
		}

		{
			!isCanonical && !isCurrent && current && (
				<div class="notice">
					<p>
						This is an older release. The current release is{' '}
						<a href={withBase(releasePath(dataset.data.slug, current.data.id))}>
							{current.data.versionLabel}
						</a>
						.
					</p>
				</div>
			)
		}
	</header>

	<nav class="section-menu" aria-label="Sections">
		<ul>
			{SECTIONS.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
		</ul>
	</nav>

	<section id="overview" class="stack">
		<h2>Overview</h2>
		<div class="prose"><slot /></div>
		{data.cohort && <p><strong>Cohort:</strong> {data.cohort}</p>}
		{
			data.tasks.length > 0 && (
				<p>
					<strong>Supported tasks:</strong> {data.tasks.map(humanize).join(', ')}
				</p>
			)
		}
		<h3>Counts</h3>
		<div class="table-scroll">
			<table>
				<caption class="visually-hidden">Counts by unit for {data.versionLabel}</caption>
				<thead>
					<tr><th scope="col">Unit</th><th scope="col">Count</th></tr>
				</thead>
				<tbody>
					{countRows.map(([label, value]) => (
						<tr>
							<th scope="row">{label}</th>
							<td>{countLabel(value)}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
		{
			data.limitations.length > 0 && (
				<>
					<h3>Limitations</h3>
					<ul>{data.limitations.map((item) => <li>{item}</li>)}</ul>
				</>
			)
		}
	</section>

	<section id="dictionary" class="stack">
		<h2>Data dictionary</h2>
		<Dictionary release={release} variables={variables} />
	</section>

	<section id="samples" class="stack">
		<h2>Samples</h2>
		<Samples samples={samples} officialUrl={dataset.data.officialUrl} />
	</section>

	<section id="structure" class="stack">
		<h2>Structure and pairing</h2>
		{data.structure ? <p class="prose">{data.structure}</p> : <p>Not documented.</p>}
		<h3>Pairing</h3>
		{
			data.pairing.length === 0 ? (
				<p>Pairing between modalities is not documented for this release.</p>
			) : (
				<div class="table-scroll">
					<table>
						<thead>
							<tr>
								<th scope="col">Pairing</th>
								<th scope="col">Modalities</th>
								<th scope="col">Status</th>
								<th scope="col">Note</th>
							</tr>
						</thead>
						<tbody>
							{data.pairing.map((entry) => (
								<tr>
									<th scope="row">{humanize(entry.kind)}</th>
									<td>{entry.modalities.map(humanize).join(', ') || '—'}</td>
									<td>{stateLabel(entry.status)}</td>
									<td>{entry.note ?? '—'}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			)
		}

		<h3>Overlap with other releases</h3>
		{
			overlaps.length === 0 ? (
				<p>
					No overlap with another release in this catalog is documented. That is not evidence that the cohorts
					are independent.
				</p>
			) : (
				<div class="table-scroll">
					<table>
						<thead>
							<tr>
								<th scope="col">Other release</th>
								<th scope="col">Overlap</th>
								<th scope="col">Shared cases</th>
								<th scope="col">Explanation</th>
							</tr>
						</thead>
						<tbody>
							{overlaps.map((entry) => (
								<tr>
									<th scope="row">
										{entry.releases
											.filter((id) => id !== data.id)
											.map((id) => releaseLabel(id))
											.join(', ')}
									</th>
									<td>{humanize(entry.type)}</td>
									<td>{countLabel(entry.count)}</td>
									<td>{entry.explanation}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			)
		}
	</section>

	<section id="papers" class="stack">
		<h2>Papers and models</h2>
		<h3>Original publication</h3>
		{
			originalUses.length === 0 ? (
				<p>The dataset's own publication is not recorded yet.</p>
			) : (
				<ul>
					{originalUses.map(({ paper }) =>
						paper ? (
							<li>
								<a href={withBase(paperPath(paper.data.slug))}>{paper.data.title}</a>
								{paper.data.year && <> ({paper.data.year})</>}
							</li>
						) : null,
					)}
				</ul>
			)
		}
		<h3>Studies using this release</h3>
		{
			downstreamUses.length === 0 ? (
				<div class="empty-state">
					<p>No verified downstream uses are recorded yet.</p>
					<p>A paper that mentions a dataset is not listed here until its actual use is checked.</p>
				</div>
			) : (
				<div class="table-scroll">
					<table>
						<thead>
							<tr>
								<th scope="col">Paper</th>
								<th scope="col">Year</th>
								<th scope="col">Task</th>
								<th scope="col">Subset</th>
								<th scope="col">Train/test role</th>
							</tr>
						</thead>
						<tbody>
							{downstreamUses.map(({ use, paper }) => (
								<tr>
									<th scope="row">
										{paper ? (
											<a href={withBase(paperPath(paper.data.slug))}>{paper.data.title}</a>
										) : (
											use.paper
										)}
									</th>
									<td>{paper?.data.year ?? 'Not documented'}</td>
									<td>{use.task ? humanize(use.task) : 'Not documented'}</td>
									<td>{use.subset ?? 'Not documented'}</td>
									<td>{trainTestLabel(use.trainTestRole)}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			)
		}
	</section>

	<section id="quality" class="stack">
		<h2>Quality</h2>
		{
			findings.length === 0 ? (
				<div class="empty-state">
					<p>No quality findings are recorded for this release.</p>
					<p>An empty list does not mean the data are error-free; it means nothing has been inspected yet.</p>
				</div>
			) : (
				<ul class="stack">
					{findings.map((finding) => (
						<li>
							<strong>{humanize(finding.category)}:</strong> {finding.description}
							<br />
							<small>
								Inspected scope: {finding.inspectedScope} · Affected: {countLabel(finding.affected)}
							</small>
						</li>
					))}
				</ul>
			)
		}
	</section>

	<section id="access" class="stack">
		<h2>Access and sources</h2>
		<dl>
			<dt>Access</dt>
			<dd>
				{accessLabel(data.access.mode)}
				{data.access.registrationVisible && ' — registration required before download'}
			</dd>
			<dt>Instructions</dt>
			<dd>{data.access.instructions}</dd>
			<dt>License</dt>
			<dd>
				{data.license.url ? <a href={data.license.url}>{data.license.name}</a> : data.license.name}
				{data.license.conditions && <> — {data.license.conditions}</>}
			</dd>
			<dt>De-identification</dt>
			<dd>{data.deidentification.statement} ({stateLabel(data.deidentification.status)})</dd>
			{data.citation && (
				<>
					<dt>Citation</dt>
					<dd>{data.citation}</dd>
				</>
			)}
		</dl>
		<p>This site does not grant access to any dataset and cannot give permission on a provider's behalf.</p>

		<h3 id="sources">Sources</h3>
		{
			sources.length === 0 ? (
				<p>No sources are recorded for this release yet.</p>
			) : (
				<ol class="sources">
					{sources.map((entry) => (
						<li>
							<a href={entry.url}>{entry.title}</a>
							{entry.locator && <> — {entry.locator}</>}
							<small> (read {dateLabel(entry.accessedOn)})</small>
						</li>
					))}
				</ol>
			)
		}
	</section>
</article>

<script>
	// Citation copy. Without JavaScript the citation is still readable in the
	// access section, so nothing is lost when this does not run.
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-citation]')) {
		button.addEventListener('click', async () => {
			const status = document.querySelector<HTMLElement>('[data-copy-status]');
			try {
				await navigator.clipboard.writeText(button.dataset.copyCitation ?? '');
				if (status) status.textContent = 'Citation copied.';
			} catch {
				if (status) status.textContent = 'Could not copy; the citation is under Access and sources.';
			}
		});
	}
</script>

<style>
	.release__header {
		border-bottom: 1px solid var(--border);
		padding-bottom: 1rem;
		margin-bottom: 1rem;
	}

	.release__header .badge + .badge {
		margin-left: 0.35rem;
	}

	.release__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.9rem;
	}

	.copy-status {
		font-size: 0.9rem;
		color: var(--ink-muted);
	}

	.release__switcher {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem;
		font-size: 0.95rem;
	}

	.release__switcher ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.release__switcher small {
		color: var(--ink-muted);
		margin-left: 0.3rem;
	}

	.sources {
		padding-left: 1.2rem;
	}

	.sources small {
		color: var(--ink-muted);
	}

	.section-menu {
		position: sticky;
		top: 0;
		z-index: 2;
		background: var(--surface);
		border-bottom: 1px solid var(--border);
		margin-bottom: 1.5rem;
	}

	.section-menu ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		list-style: none;
		margin: 0;
		padding: 0.5rem 0;
		font-size: 0.95rem;
	}

	section {
		margin-bottom: 2.5rem;
		scroll-margin-top: 3.5rem;
	}

	dl dt {
		font-weight: 650;
		margin-top: 0.6rem;
	}

	dl dd {
		margin: 0;
	}

	details summary {
		cursor: pointer;
		color: var(--accent-ink);
		font-size: 0.9rem;
	}

	.sample-list {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 1.25rem;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
	}

	.sample-list figure {
		margin: 0;
	}

	.sample-list img {
		width: 100%;
		height: auto;
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>
