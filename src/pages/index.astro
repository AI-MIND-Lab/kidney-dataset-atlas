---
import BaseLayout from '../layouts/BaseLayout.astro';
import Explorer from '../components/Explorer.astro';
import { explorerEntries, facetOptions } from '../lib/catalog';
import { SITE, withBase } from '../lib/site';

const entries = await explorerEntries();
const options = facetOptions(entries);
---

<BaseLayout title={SITE.title}>
	<h1>{SITE.title}</h1>
	<p class="lede">{SITE.description}</p>

	{
		entries.length === 0 ? (
			<div class="empty-state stack">
				<p>
					<strong>No datasets are published yet.</strong>
				</p>
				<p>
					Records appear here once a curator has checked their eligibility and approved them. See{' '}
					<a href={withBase('/about/')}>About</a> for what that check covers.
				</p>
			</div>
		) : (
			<Explorer entries={entries} options={options} />
		)
	}
</BaseLayout>
