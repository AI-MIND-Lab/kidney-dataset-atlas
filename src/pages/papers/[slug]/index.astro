---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import ModelPipeline from '../../../components/ModelPipeline.astro';
import ModelTable from '../../../components/ModelTable.astro';
import PaperFigure from '../../../components/PaperFigure.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { catalog, publishedPapers, studyUsesForPaper } from '../../../lib/catalog';
import { accessLabel, humanize, trainTestLabel } from '../../../lib/display';
import { groupResults } from '../../../lib/results';
import { withBase } from '../../../lib/site';
import { studyUseTarget } from '../../../lib/study-use-target';

export const getStaticPaths = (async () => {
	const papers = await publishedPapers();
	return papers.map((paper) => ({ params: { slug: paper.data.slug }, props: { paper } }));
}) satisfies GetStaticPaths;

const { paper } = Astro.props;
const { Content } = await render(paper);
const uses = await studyUsesForPaper(paper.data.id);
const catalogEntries = await catalog();
const papersById = new Map(
	(await publishedPapers()).map((entry) => [entry.data.id, { title: entry.data.title, slug: entry.data.slug }]),
);
const releaseContexts = new Map(
	catalogEntries.flatMap(({ dataset, releases }) =>
		releases.map((release) => [
			release.data.id,
			{
				datasetSlug: dataset.data.slug,
				datasetName: dataset.data.name,
				releaseId: release.data.id,
				versionLabel: release.data.versionLabel,
			},
		] as const),
	),
);

/** "TCGA-KIRC (TCIA radiology collection)": short enough for a results cell. */
const shortTarget = (use: (typeof uses)[number]) => {
	const context = use.release ? releaseContexts.get(use.release) : undefined;
	if (!context) return studyUseTarget(use, context).label;
	return `${context.datasetName.split(' — ')[0]} (${context.versionLabel})`;
};

// Proposed models first, then variants, then baselines.
const ORDER = { proposed: 0, variant: 1, baseline: 2 } as const;
const models = [...paper.data.models].sort((a, b) => ORDER[a.role] - ORDER[b.role]);
const modelName = new Map(models.map((model) => [model.id, model.name]));

// A result that covers several releases is recorded once per release; show it once, listing where it applies.
const results = groupResults(
	uses,
	models.map((model) => model.id),
);
/** "TCGA-KIRC, TCGA-KIRP and TCGA-KICH (TCIA radiology collection)" rather than three long labels. */
const targetList = (list: (typeof uses)[number][]) => {
	const contexts = list.map((use) => (use.release ? releaseContexts.get(use.release) : undefined));
	const versions = new Set(contexts.map((context) => context?.versionLabel.replace(/ \(.*\)$/, '')));
	if (contexts.every(Boolean) && versions.size === 1) {
		const names = contexts.map((context) => context!.datasetName.split(' — ')[0]);
		const joined = names.length > 1 ? `${names.slice(0, -1).join(', ')} and ${names.at(-1)}` : names[0];
		return `${joined} (${[...versions][0]})`;
	}
	return list.map(shortTarget).join('; ');
};
const documented = (value: string | null | undefined) => value && !/^not documented/i.test(value);
---

<BaseLayout title={paper.data.title} description={paper.data.methodSummary ?? paper.data.title}>
	<article class="stack">
		<h1>{paper.data.title}</h1>
		<p class="lede">{paper.data.authors.join(', ')}</p>
		<p>
			{paper.data.year ?? 'Year not documented'} · {paper.data.venue ?? 'Venue not documented'} ·{' '}
			{humanize(paper.data.publicationStatus)}
			{paper.data.doi && <> · DOI <a href={`https://doi.org/${paper.data.doi}`}>{paper.data.doi}</a></>}
			{!paper.data.doi && paper.data.url && <> · <a href={paper.data.url}>Official page</a></>}
		</p>

		<section id="method" class="stack">
			<h2>Method</h2>
			{paper.data.methodSummary && <p class="lede">{paper.data.methodSummary}</p>}
			<div class="prose"><Content /></div>
		</section>

		<section id="architectures" class="stack">
			<h2>Architecture</h2>
			{paper.data.figures.map((figure) => <PaperFigure figure={figure} />)}
			{
				paper.data.linkedFigures.map((figure) => (
					<aside class="linked-figure">
						<strong>
							{figure.label} of the paper · {figure.title}
						</strong>
						<p>{figure.summary}</p>
						<p>
							<a href={figure.url}>View {figure.label.toLowerCase()} in the paper</a>
						</p>
						<p class="paper-figure__credit">{figure.reason} The atlas diagram below is drawn from the paper's text.</p>
					</aside>
				))
			}
			{models.map((model) => <ModelPipeline model={model} />)}
			{
				models.length === 0 ? (
					<p>No architectures are documented for this paper yet.</p>
				) : (
					<ModelTable models={models} papersById={papersById} />
				)
			}
		</section>

		{
			results.length > 0 && (
				<section id="results" class="stack">
					<h2>Reported results</h2>
					<div class="table-scroll">
						<table class="results-table">
							<thead>
								<tr>
									<th scope="col">Model</th>
									<th scope="col">Metric</th>
									<th scope="col">Value</th>
									<th scope="col">Evaluated on</th>
									<th scope="col">Split</th>
									<th scope="col">Evaluation</th>
								</tr>
							</thead>
							<tbody>
								{results.map(({ result, uses: resultUses }) => (
									<tr>
										<td>{modelName.get(result.model) ?? result.model}</td>
										<th scope="row">{result.metric}</th>
										<td class="value">
											{result.value ?? 'Not documented'}
											{result.units && ` ${result.units}`}
											{result.confidenceInterval && <small class="model-table__note">{result.confidenceInterval}</small>}
										</td>
										<td>
											{result.subset ?? 'Not documented'}
											<small class="model-table__note">Catalogue records: {targetList(resultUses)}</small>
										</td>
										<td>
											{result.split ?? 'Not documented'}
											{documented(result.patientLevelHandling) && (
												<small class="model-table__note">{result.patientLevelHandling}</small>
											)}
										</td>
										<td>
											{humanize(result.evaluation)}
											{result.evidence?.status !== 'verified' && <span class="badge">Not verified</span>}
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
					{
						results.some(({ result }) => result.evidence?.note) && (
							<ul class="muted">
								{[...new Set(results.map(({ result }) => result.evidence?.note).filter(Boolean))].map((note) => (
									<li>{note}</li>
								))}
							</ul>
						)
					}
				</section>
			)
		}

		<section id="datasets" class="stack">
			<h2>Datasets used</h2>
			{
				uses.length === 0 ? (
					<p>No dataset use is recorded for this paper yet.</p>
				) : (
					<div class="table-scroll">
						<table>
							<thead>
								<tr>
									<th scope="col">Release or cohort</th>
									<th scope="col">Role</th>
									<th scope="col">Subset</th>
									<th scope="col">Train/test role</th>
									<th scope="col">Split</th>
									<th scope="col">Relationship evidence</th>
								</tr>
							</thead>
							<tbody>
								{uses.map((use) => {
									const context = use.release ? releaseContexts.get(use.release) : undefined;
									const target = studyUseTarget(use, context);
									return (
										<tr>
											<th scope="row">
												{target.path ? (
													<a href={withBase(target.path)}>{target.label}</a>
												) : use.externalCohort ? (
													<>
														{target.label}{' '}
														<span class="badge">{accessLabel(use.externalCohort.accessMode)}</span>
													</>
												) : (
													target.label
												)}
											</th>
											<td>{humanize(use.role)}</td>
											<td>{use.subset ?? 'Not documented'}</td>
											<td>{trainTestLabel(use.trainTestRole)}</td>
											<td>{use.split ?? 'Not documented'}</td>
											<td>{use.actualUseEvidence.status === 'verified' ? 'Verified' : 'Not verified'}</td>
										</tr>
									);
								})}
							</tbody>
						</table>
					</div>
				)
			}
		</section>
	</article>
</BaseLayout>
